---
import '../styles/global.css';
import Header from '../components/Header.astro';
import { ArrowUpRight, Mail, MapPin } from 'lucide-react';
import { LOCALE, SITE, withBase } from '../config';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const { title, description = SITE.description } = Astro.props;
const pageTitle = title && title !== 'Home' ? `${title} · ${SITE.labName}` : `${SITE.labName} · ${SITE.university}`;
const siteBase = Astro.site ?? new URL(Astro.url.origin);
const canonicalUrl = new URL(Astro.url.pathname, siteBase);
const homeLink = withBase('/');
const basePrefix = import.meta.env.BASE_URL;
const baseNoSlash = basePrefix.replace(/\/$/, '');
const isHomePage = Astro.url.pathname === basePrefix || Astro.url.pathname === baseNoSlash;
const pathWithoutBase = Astro.url.pathname.startsWith(basePrefix)
  ? Astro.url.pathname.slice(basePrefix.length)
  : Astro.url.pathname.startsWith(baseNoSlash)
    ? Astro.url.pathname.slice(baseNoSlash.length)
    : Astro.url.pathname.replace(/^\//, '');
const currentPath = pathWithoutBase.replace(/^\/|\/$/g, '');
const ogSlug = currentPath || 'index';
const supportedTopLevel = ['index', 'research', 'projects', 'team', 'publications', 'news', 'join'];
const topLevel = ogSlug.split('/')[0];
const finalOgSlug = supportedTopLevel.includes(topLevel) ? ogSlug : 'index';
const ogImage = new URL(withBase(`/og/${finalOgSlug}.png`), siteBase);

const organizationSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'ResearchOrganization',
      '@id': `${siteBase.href}#lab`,
      name: SITE.labName,
      url: siteBase.href,
      logo: new URL(SITE.logo, siteBase).href,
      description: SITE.description,
      parentOrganization: {
        '@type': 'CollegeOrUniversity',
        name: 'Sabancı University',
        url: 'https://www.sabanciuniv.edu/',
      },
      address: {
        '@type': 'PostalAddress',
        streetAddress: 'Orta Mahalle',
        postalCode: '34956',
        addressLocality: 'Tuzla',
        addressRegion: 'İstanbul',
        addressCountry: 'TR',
      },
      email: SITE.email,
      founder: { '@id': `${siteBase.href}#principal-investigator` },
    },
    {
      '@type': 'Person',
      '@id': `${siteBase.href}#principal-investigator`,
      name: SITE.profile.name,
      jobTitle: SITE.profile.role,
      affiliation: { '@id': `${siteBase.href}#lab` },
      sameAs: [
        SITE.profile.officialUrl,
        SITE.profile.scholarUrl,
        SITE.profile.orcidUrl,
        SITE.profile.linkedinUrl,
      ],
    },
  ],
};
---

<!doctype html>
<html lang={LOCALE.lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#002776" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <link rel="canonical" href={canonicalUrl} />
    <title>{pageTitle}</title>

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content={SITE.labName} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {isHomePage && <script is:inline type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />}
  </head>
  <body class="min-h-screen bg-white text-slate-800">
    <Header />
    <main id="main-content" class="min-h-[60vh]" data-pagefind-body>
      <slot />
    </main>

    <footer class="relative overflow-hidden bg-[#061a2b] text-slate-300">
      <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-[#5de4df] to-transparent opacity-60"></div>
      <div class="mx-auto grid max-w-[90rem] gap-12 px-4 py-14 sm:px-6 md:grid-cols-[1.3fr_0.7fr_1fr] lg:px-10 lg:py-18">
        <div class="max-w-md">
          <a href={homeLink} class="inline-flex items-center gap-3 text-white">
            <img src={SITE.logo} width="44" height="44" alt="" class="h-11 w-11" />
            <span>
              <span class="block text-lg font-bold">{SITE.labName}</span>
              <span class="text-xs font-semibold uppercase tracking-[0.14em] text-[#7bdedb]">Integrated Circuits & Systems</span>
            </span>
          </a>
          <p class="mt-5 text-sm leading-7 text-slate-400">
            Energy-efficient integrated circuits and intelligent hardware for future wireless communication and sensing.
          </p>
        </div>

        <div>
          <h2 class="text-xs font-bold uppercase tracking-[0.18em] text-white">Explore</h2>
          <nav class="mt-5 grid gap-3 text-sm" aria-label="Footer navigation">
            {SITE.nav.filter((item) => item.key !== 'search').map((item) => (
              <a href={item.link} class="w-fit transition-colors hover:text-[#7bdedb]">{item.text}</a>
            ))}
          </nav>
        </div>

        <div>
          <h2 class="text-xs font-bold uppercase tracking-[0.18em] text-white">Contact</h2>
          <div class="mt-5 space-y-4 text-sm">
            <a href={`mailto:${SITE.email}`} class="flex items-start gap-3 transition-colors hover:text-[#7bdedb]">
              <Mail className="mt-0.5 h-4 w-4 shrink-0" />
              <span>{SITE.email}</span>
            </a>
            <p class="flex items-start gap-3 leading-6 text-slate-400">
              <MapPin className="mt-1 h-4 w-4 shrink-0" />
              <span>Sabancı University FENS<br />Tuzla, İstanbul, Türkiye</span>
            </p>
            <a href={SITE.profile.officialUrl} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 font-semibold text-white hover:text-[#7bdedb]">
              Official university profile <ArrowUpRight className="h-3.5 w-3.5" />
            </a>
          </div>
        </div>
      </div>

      <div class="border-t border-white/10">
        <div class="mx-auto flex max-w-[90rem] flex-col gap-2 px-4 py-5 text-xs text-slate-500 sm:flex-row sm:items-center sm:justify-between sm:px-6 lg:px-10">
          <p>© {new Date().getFullYear()} {SITE.labName}. All rights reserved.</p>
          <p>Sabancı University · Faculty of Engineering and Natural Sciences</p>
        </div>
      </div>
    </footer>
  </body>
</html>

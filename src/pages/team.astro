---
import { getCollection } from 'astro:content';
import { ArrowUpRight, Users } from 'lucide-react';
import Layout from '../layouts/Layout.astro';
import TeamCard from '../components/TeamCard.astro';
import { withBase } from '../config';

const allMembers = (await getCollection('team')).sort((a, b) => a.data.weight - b.data.weight);
const groups = [
  { title: 'Principal Investigator', roles: ['Principal Investigator'] },
  { title: 'Postgraduate', roles: ['Postgraduate'] },
  { title: 'Doctorate', roles: ['Doctorate'] },
  { title: 'Graduate', roles: ['Graduate'] },
  { title: 'Undergraduate', roles: ['Undergraduate'] },
  { title: 'Alumni', roles: ['Alumni'] },
]
  .map((group) => ({ ...group, members: allMembers.filter((member) => group.roles.includes(member.data.role)) }))
  .filter((group) => group.members.length > 0);
---

<Layout title="People" description="The researchers and students of Tokgöz Lab at Sabancı University.">
  <header class="page-intro">
    <div class="section-shell relative z-10 py-16 sm:py-24">
      <span class="eyebrow">People</span>
      <div class="mt-5 grid gap-8 lg:grid-cols-[1fr_0.7fr] lg:items-end">
        <h1 class="max-w-4xl text-5xl font-bold leading-[1.02] tracking-[-0.055em] text-[#071b26] sm:text-6xl">The people behind the circuits.</h1>
        <p class="text-lg leading-8 text-slate-600">A research group connecting integrated-circuit design, high-frequency measurement, communication systems, and intelligent edge hardware.</p>
      </div>
    </div>
  </header>

  <section class="py-16 sm:py-24">
    <div class="section-shell space-y-20">
      {groups.map((group) => (
        <section>
          <div class="mb-8 flex items-center gap-3">
            <span class="h-8 w-1 rounded-full bg-[#00a6a6]"></span>
            <h2 class="text-2xl font-bold tracking-[-0.025em] text-[#071b26]">{group.title}</h2>
          </div>
          <div class="grid max-w-5xl gap-7 sm:grid-cols-2 lg:grid-cols-3">
            {group.members.map((member) => <TeamCard member={member} />)}
          </div>
        </section>
      ))}

      {allMembers.length === 0 && (
        <div class="rounded-3xl border border-dashed border-slate-300 bg-slate-50 p-12 text-center">
          <Users className="mx-auto h-8 w-8 text-slate-400" />
          <p class="mt-4 text-slate-600">Team profiles are being prepared.</p>
        </div>
      )}
    </div>
  </section>

  <section class="pb-20 sm:pb-28">
    <div class="section-shell rounded-3xl bg-[#061a2b] px-7 py-10 text-white sm:px-12 sm:py-12 lg:flex lg:items-center lg:justify-between lg:gap-10">
      <div class="max-w-2xl">
        <p class="text-xs font-bold uppercase tracking-[0.15em] text-[#7bdedb]">Future lab members</p>
        <h2 class="mt-3 text-3xl font-bold tracking-[-0.035em]">Interested in joining the team?</h2>
        <p class="mt-4 leading-7 text-slate-300">Explore research paths for PhD, master’s, and undergraduate students.</p>
      </div>
      <a href={withBase('/join')} class="mt-7 inline-flex shrink-0 items-center gap-2 rounded-full bg-[#ffb547] px-6 py-3 text-sm font-bold text-[#071b26] lg:mt-0">
        View opportunities <ArrowUpRight className="h-4 w-4" />
      </a>
    </div>
  </section>
</Layout>

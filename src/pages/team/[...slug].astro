---
import { getCollection, render } from 'astro:content';
import { ArrowLeft, ArrowUpRight, ExternalLink, GraduationCap, Mail } from 'lucide-react';
import Layout from '../../layouts/Layout.astro';
import { withBase } from '../../config';

export async function getStaticPaths() {
  const teamMembers = await getCollection('team');
  return teamMembers.map((member) => ({
    params: { slug: member.id.replace(/\.[^/.]+$/, '') },
    props: { member },
  }));
}

const { member } = Astro.props;
const { Content } = await render(member);
const { name, role, title, avatar, email, website, linkedin, googleScholar, bio } = member.data;
---

<Layout title={name} description={bio}>
  <header class="relative overflow-hidden bg-[#061a2b] text-white">
    <div class="signal-grid absolute inset-0 opacity-50"></div>
    <div class="section-shell relative py-12 sm:py-18">
      <a href={withBase('/team')} class="inline-flex items-center gap-2 text-sm font-bold text-[#7bdedb] hover:text-white">
        <ArrowLeft className="h-4 w-4" /> Back to people
      </a>

      <div class="mt-10 grid items-center gap-10 md:grid-cols-[16rem_1fr] lg:gap-14">
        <div class="overflow-hidden rounded-3xl border border-white/15 bg-white/5 p-2 shadow-2xl">
          <img src={avatar.src} alt={name} class="aspect-square w-full rounded-[1.15rem] object-cover" />
        </div>
        <div>
          <p class="text-xs font-bold uppercase tracking-[0.16em] text-[#7bdedb]">{role}</p>
          <h1 class="mt-3 text-4xl font-bold tracking-[-0.045em] sm:text-6xl">{name}</h1>
          {title?.length && <p class="mt-4 text-lg font-semibold text-slate-300">{title.join(' · ')}</p>}
          <div class="mt-8 flex flex-wrap gap-2">
            {email && <a href={`mailto:${email}`} class="inline-flex items-center gap-2 rounded-full bg-white px-4 py-2.5 text-sm font-bold text-[#002776]"><Mail className="h-4 w-4" /> Email</a>}
            {website && <a href={website} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 rounded-full border border-white/20 px-4 py-2.5 text-sm font-bold text-white hover:bg-white/10"><ExternalLink className="h-4 w-4" /> University profile</a>}
            {googleScholar && <a href={googleScholar} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 rounded-full border border-white/20 px-4 py-2.5 text-sm font-bold text-white hover:bg-white/10"><GraduationCap className="h-4 w-4" /> Scholar</a>}
            {linkedin && <a href={linkedin} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 rounded-full border border-white/20 px-4 py-2.5 text-sm font-bold text-white hover:bg-white/10"><svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M6.5 8.5H3V21h3.5V8.5ZM4.75 3A2.05 2.05 0 1 0 4.8 7.1 2.05 2.05 0 0 0 4.75 3ZM21 14.1c0-3.76-2-5.51-4.68-5.51a4.04 4.04 0 0 0-3.67 2.02V8.5H9.14V21h3.51v-6.19c0-1.63.31-3.21 2.33-3.21 1.99 0 2.02 1.86 2.02 3.32V21h3.5l.5-6.9Z" /></svg> LinkedIn</a>}
          </div>
        </div>
      </div>
    </div>
  </header>

  <article class="section-shell grid gap-12 py-16 sm:py-24 lg:grid-cols-[1fr_19rem] lg:gap-20">
    <div class="prose max-w-3xl">
      <Content />
    </div>
    <aside class="h-fit rounded-2xl border border-slate-200 bg-[#f5f8fa] p-6 lg:sticky lg:top-28">
      <p class="text-xs font-bold uppercase tracking-[0.15em] text-[#007f80]">At a glance</p>
      <dl class="mt-5 space-y-5 text-sm">
        <div>
          <dt class="font-bold text-[#071b26]">Affiliation</dt>
          <dd class="mt-1 leading-6 text-slate-600">Electronics Engineering<br />Sabancı University</dd>
        </div>
        <div>
          <dt class="font-bold text-[#071b26]">Doctorate</dt>
          <dd class="mt-1 leading-6 text-slate-600">Physical Electronics<br />Tokyo Institute of Technology, 2018</dd>
        </div>
        <div>
          <dt class="font-bold text-[#071b26]">Research span</dt>
          <dd class="mt-1 leading-6 text-slate-600">CMOS circuits · sub-THz · 6G · Edge AI · IoT</dd>
        </div>
      </dl>
      <a href={withBase('/publications')} class="mt-7 inline-flex items-center gap-2 text-sm font-bold text-[#002776]">Selected publications <ArrowUpRight className="h-4 w-4" /></a>
    </aside>
  </article>
</Layout>

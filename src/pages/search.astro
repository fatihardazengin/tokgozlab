---
import { Search as SearchIcon } from 'lucide-react';
import Layout from '../layouts/Layout.astro';
import { withBase } from '../config';

export const prerender = true;
const pagefindBase = withBase('/pagefind/');
---

<Layout title="Search" description="Search Tokgöz Lab research areas, publications, and people.">
  <header class="page-intro">
    <div class="section-shell relative z-10 py-16 sm:py-20">
      <span class="eyebrow">Search</span>
      <h1 class="mt-5 text-5xl font-bold tracking-[-0.05em] text-[#071b26] sm:text-6xl">Find research across the lab.</h1>
      <p class="mt-5 max-w-2xl text-lg leading-8 text-slate-600">Search publications, research themes, and people indexed across this site.</p>
    </div>
  </header>

  <section class="py-14 sm:py-20">
    <div class="section-shell max-w-5xl">
      <div class="rounded-3xl border border-slate-200 bg-white p-5 shadow-sm sm:p-8">
        <div class="mb-5 flex items-center gap-2 text-sm font-bold text-[#002776]"><SearchIcon className="h-4 w-4" /> Site search</div>
        <div id="search" class="w-full"></div>
        <noscript><p class="rounded-xl bg-slate-50 p-4 text-sm text-slate-600">Search requires JavaScript.</p></noscript>
      </div>
    </div>
  </section>

  <link href={`${pagefindBase}pagefind-ui.css`} rel="stylesheet" />
  <script src={`${pagefindBase}pagefind-ui.js`} is:inline></script>
  <script define:vars={{ pagefindBase }}>
    window.addEventListener('DOMContentLoaded', () => {
      if (typeof PagefindUI === 'undefined') return;
      new PagefindUI({
        element: '#search',
        bundlePath: pagefindBase,
        showSubResults: true,
        pageSize: 10,
        showImages: false,
        translations: {
          placeholder: 'Search publications, topics, people…',
          clear_search: 'Clear',
          load_more: 'Load more results',
          search_label: 'Search this site',
          filters_label: 'Filters',
          zero_results: 'No results found for [SEARCH_TERM]',
          many_results: '[COUNT] results found for [SEARCH_TERM]',
          one_result: '[COUNT] result found for [SEARCH_TERM]',
          searching: 'Searching for [SEARCH_TERM]…',
        },
      });
    });
  </script>

  <style is:global>
    .pagefind-ui {
      --pagefind-ui-primary: #002776;
      --pagefind-ui-text: #334155;
      --pagefind-ui-background: #ffffff;
      --pagefind-ui-border: #cbd5e1;
      --pagefind-ui-tag: #e7f7f6;
      --pagefind-ui-border-width: 1px;
      --pagefind-ui-border-radius: 0.85rem;
      --pagefind-ui-font: 'Inter', sans-serif;
    }
    .pagefind-ui__search-input {
      font-weight: 600 !important;
    }
    .pagefind-ui__result-link {
      color: #071b26 !important;
      font-weight: 700 !important;
    }
  </style>
</Layout>

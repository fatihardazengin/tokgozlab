---
import { ArrowUpRight, CheckCircle2, Clock3, Cpu, Radio, Waves } from 'lucide-react';
import Layout from '../layouts/Layout.astro';
import { activeProjects, completedProjects } from '../data/projects';

const themeIcons = [Waves, Cpu, Radio, Radio, Cpu];
---

<Layout title="Projects" description="Selected active and completed research projects led by Tokgöz Lab at Sabancı University.">
  <header class="page-intro">
    <div class="section-shell relative z-10 py-16 sm:py-24">
      <span class="eyebrow">Projects</span>
      <div class="mt-5 grid gap-8 lg:grid-cols-[1fr_0.7fr] lg:items-end">
        <h1 class="max-w-4xl text-5xl font-bold leading-[1.02] tracking-[-0.055em] text-[#071b26] sm:text-6xl">Research programs with real hardware outcomes.</h1>
        <div>
          <p class="text-lg leading-8 text-slate-600">Selected projects led by Korkut Kaan Tokgöz, spanning advanced CMOS, future wireless links, and resource-efficient intelligent systems.</p>
          <a href="https://fens.sabanciuniv.edu/en/en/research-areas/projects" target="_blank" rel="noopener noreferrer" class="mt-5 inline-flex items-center gap-2 text-sm font-bold text-[#007f80]">Official FENS project directory <ArrowUpRight className="h-4 w-4" /></a>
        </div>
      </div>
    </div>
  </header>

  <section class="py-16 sm:py-24">
    <div class="section-shell">
      <div class="flex items-center gap-3">
        <Clock3 className="h-6 w-6 text-[#007f80]" />
        <h2 class="text-3xl font-bold tracking-[-0.035em] text-[#071b26]">Active projects</h2>
      </div>

      <div class="mt-10 grid gap-5 md:grid-cols-2 xl:grid-cols-3">
        {activeProjects.map((project, index) => {
          const Icon = themeIcons[index];
          return (
            <article class="card-lift relative overflow-hidden rounded-3xl border border-slate-200 bg-white p-7">
              <div class="flex items-start justify-between gap-4">
                <span class="flex h-11 w-11 items-center justify-center rounded-xl bg-[#e7f7f6] text-[#007f80]"><Icon className="h-5 w-5" /></span>
                <span class="rounded-full bg-slate-100 px-3 py-1 text-[0.68rem] font-bold uppercase tracking-[0.1em] text-slate-500">{project.type}</span>
              </div>
              <p class="mt-7 font-mono text-xs font-bold text-[#002776]">{project.period}</p>
              <h3 class="mt-3 min-h-28 text-lg font-bold leading-snug text-[#071b26]">{project.title}</h3>
              <p class="mt-5 border-t border-slate-100 pt-4 text-xs font-bold uppercase tracking-[0.11em] text-[#007f80]">{project.theme}</p>
            </article>
          );
        })}
      </div>
    </div>
  </section>

  <section class="border-t border-slate-200 bg-[#f3f7fa] py-16 sm:py-24">
    <div class="section-shell grid gap-10 lg:grid-cols-[0.6fr_1.4fr] lg:gap-20">
      <div>
        <div class="flex items-center gap-3"><CheckCircle2 className="h-6 w-6 text-[#007f80]" /><h2 class="text-3xl font-bold tracking-[-0.035em] text-[#071b26]">Selected completed work</h2></div>
        <p class="mt-5 leading-7 text-slate-600">Programs that established foundations for the lab’s current circuit and system research.</p>
      </div>
      <div class="divide-y divide-slate-200 border-y border-slate-200">
        {completedProjects.map((project) => (
          <article class="grid gap-3 py-7 sm:grid-cols-[7rem_1fr] sm:gap-7">
            <span class="font-mono text-sm font-bold text-[#002776]">{project.period}</span>
            <h3 class="font-bold leading-7 text-[#071b26]">{project.title}</h3>
          </article>
        ))}
      </div>
    </div>
  </section>
</Layout>

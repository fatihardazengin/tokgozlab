---
import { ArrowUpRight, Code2, FileText, Globe2, Play, Presentation, Video } from 'lucide-react';
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'publications'>;
}

const { entry } = Astro.props;
const { title, authors, year, venue, links, doi, award, badges } = entry.data;

const iconMap: Record<string, any> = {
  pdf: FileText,
  code: Code2,
  demo: Play,
  slides: Presentation,
  video: Video,
  website: Globe2,
};

const labelMap: Record<string, string> = {
  pdf: 'Paper',
  code: 'Code',
  demo: 'Demo',
  slides: 'Slides',
  video: 'Video',
  website: 'Publisher',
};

const isLabAuthor = (author: string) => /Korkut Kaan Tokg[oö]z/i.test(author);
const activeLinks = links ? Object.entries(links).filter(([, url]) => Boolean(url && url !== '#')) : [];
const doiUrl = doi ? `https://doi.org/${doi}` : undefined;
---

<article class="group grid gap-5 rounded-2xl border border-slate-200 bg-white p-6 transition hover:border-[#00a6a6]/40 hover:shadow-[0_18px_45px_-32px_rgba(0,39,118,0.45)] sm:p-7 md:grid-cols-[5rem_1fr]">
  <div>
    <span class="inline-flex rounded-lg bg-[#eaf1fb] px-3 py-2 font-mono text-sm font-bold text-[#002776]">{year}</span>
  </div>

  <div>
    <h3 class="text-lg font-bold leading-snug tracking-[-0.015em] text-[#071b26] sm:text-xl">
      {doiUrl ? (
        <a href={doiUrl} target="_blank" rel="noopener noreferrer" class="transition-colors hover:text-[#006f72]">{title}</a>
      ) : title}
    </h3>

    <p class="mt-3 text-sm leading-6 text-slate-600">
      {authors.map((author, index) => (
        <>
          <span class:list={[isLabAuthor(author) && 'font-bold text-[#002776]']}>{author}</span>{index < authors.length - 1 ? ', ' : ''}
        </>
      ))}
    </p>

    <div class="mt-4 flex flex-wrap items-center gap-2 text-sm">
      <span class="font-semibold text-slate-700">{venue}</span>
      {(badges || award) && (
        <>
          {(badges ?? [{ text: award, type: 'gold' }]).map((badge) => (
            <span class="rounded-full bg-amber-50 px-2.5 py-1 text-xs font-bold text-amber-700 ring-1 ring-inset ring-amber-200">{badge.text}</span>
          ))}
        </>
      )}
    </div>

    {(activeLinks.length > 0 || doiUrl) && (
      <div class="mt-5 flex flex-wrap gap-2">
        {activeLinks.map(([key, url]) => {
          const Icon = iconMap[key] || ArrowUpRight;
          return (
            <a href={url} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 rounded-full border border-slate-200 px-3 py-1.5 text-xs font-bold text-slate-600 transition hover:border-[#00a6a6] hover:bg-[#e7f7f6] hover:text-[#006f72]">
              <Icon className="h-3.5 w-3.5" /> {labelMap[key] ?? key}
            </a>
          );
        })}
        {doiUrl && !activeLinks.some(([, url]) => url === doiUrl) && (
          <a href={doiUrl} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 rounded-full border border-slate-200 px-3 py-1.5 text-xs font-bold text-slate-600 transition hover:border-[#00a6a6] hover:bg-[#e7f7f6] hover:text-[#006f72]">
            DOI <ArrowUpRight className="h-3.5 w-3.5" />
          </a>
        )}
      </div>
    )}
  </div>
</article>

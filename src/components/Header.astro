---
import { ArrowUpRight, Menu, Search, X } from 'lucide-react';
import { SITE } from '../config';

const pathname = Astro.url.pathname;
const regularNav = SITE.nav.filter((item) => !['search', 'join'].includes(item.key));
const isActive = (link: string) => pathname === link || (link !== '/' && pathname.startsWith(`${link}/`));
---

<header class="site-header sticky top-0 z-50 border-b border-slate-200/80 bg-white/90 backdrop-blur-xl">
  <a class="skip-link" href="#main-content">Skip to content</a>
  <div class="h-1 bg-gradient-to-r from-[#002776] via-[#00a6a6] to-[#ffb547]"></div>

  <div class="mx-auto flex h-[72px] max-w-[90rem] items-center justify-between px-4 sm:px-6 lg:px-10">
    <a href="/" class="group flex min-w-0 items-center gap-3" aria-label={`${SITE.labName} home`}>
      <img src={SITE.logo} width="44" height="44" alt="" class="h-11 w-11 shrink-0 transition-transform duration-300 group-hover:-rotate-3" />
      <span class="min-w-0">
        <span class="block text-[1.05rem] font-bold tracking-[-0.02em] text-[#071b26]">{SITE.labName}</span>
        <span class="hidden truncate text-[0.69rem] font-semibold uppercase tracking-[0.12em] text-slate-500 sm:block">
          Sabancı University · Electronics Engineering
        </span>
      </span>
    </a>

    <nav class="hidden items-center gap-1 lg:flex" aria-label="Primary navigation">
      {regularNav.map((item) => (
        <a
          href={item.link}
          aria-current={isActive(item.link) ? 'page' : undefined}
          class:list={[
            'rounded-full px-4 py-2 text-sm font-semibold transition-colors',
            isActive(item.link)
              ? 'bg-[#e7f7f6] text-[#006f72]'
              : 'text-slate-600 hover:bg-slate-100 hover:text-[#071b26]',
          ]}
        >
          {item.text}
        </a>
      ))}

      <a
        href="/search"
        class="ml-1 rounded-full p-2.5 text-slate-500 transition-colors hover:bg-slate-100 hover:text-[#002776]"
        aria-label="Search"
      >
        <Search className="h-4.5 w-4.5" />
      </a>

      <a
        href="/join"
        class="ml-2 inline-flex items-center gap-1.5 rounded-full bg-[#002776] px-5 py-2.5 text-sm font-bold text-white shadow-sm transition hover:bg-[#001d5a] hover:shadow-md"
      >
        Opportunities <ArrowUpRight className="h-4 w-4" />
      </a>
    </nav>

    <button
      id="mobile-menu-button"
      class="inline-flex h-11 w-11 items-center justify-center rounded-full border border-slate-200 text-[#071b26] transition hover:border-[#00a6a6] hover:text-[#006f72] lg:hidden"
      type="button"
      aria-controls="mobile-menu"
      aria-expanded="false"
      aria-label="Open navigation"
    >
      <Menu id="menu-open-icon" className="h-5 w-5" />
      <X id="menu-close-icon" className="hidden h-5 w-5" />
    </button>
  </div>

  <div id="mobile-menu" class="hidden border-t border-slate-200 bg-white lg:hidden" aria-hidden="true">
    <nav class="mx-auto flex max-w-[90rem] flex-col gap-1 px-4 py-5 sm:px-6" aria-label="Mobile navigation">
      {regularNav.map((item) => (
        <a
          href={item.link}
          aria-current={isActive(item.link) ? 'page' : undefined}
          class:list={[
            'rounded-xl px-4 py-3 text-base font-semibold',
            isActive(item.link) ? 'bg-[#e7f7f6] text-[#006f72]' : 'text-slate-700 hover:bg-slate-50',
          ]}
        >
          {item.text}
        </a>
      ))}
      <a href="/search" class="flex items-center gap-2 rounded-xl px-4 py-3 font-semibold text-slate-700 hover:bg-slate-50">
        <Search className="h-4 w-4" /> Search
      </a>
      <a href="/join" class="mt-2 flex items-center justify-between rounded-xl bg-[#002776] px-4 py-3 font-bold text-white">
        Opportunities <ArrowUpRight className="h-4 w-4" />
      </a>
    </nav>
  </div>
</header>

<script is:inline>
  (() => {
    const button = document.getElementById('mobile-menu-button');
    const menu = document.getElementById('mobile-menu');
    const openIcon = document.getElementById('menu-open-icon');
    const closeIcon = document.getElementById('menu-close-icon');

    if (!button || !menu) return;

    const setOpen = (open) => {
      button.setAttribute('aria-expanded', String(open));
      button.setAttribute('aria-label', open ? 'Close navigation' : 'Open navigation');
      menu.setAttribute('aria-hidden', String(!open));
      menu.classList.toggle('hidden', !open);
      openIcon?.classList.toggle('hidden', open);
      closeIcon?.classList.toggle('hidden', !open);
    };

    button.addEventListener('click', () => setOpen(button.getAttribute('aria-expanded') !== 'true'));
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') setOpen(false);
    });
  })();
</script>
